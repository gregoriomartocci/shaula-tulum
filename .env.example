# Contraseña del panel (/admin). Sin esto el panel no deja entrar.
ADMIN_PASSWORD=

# Base de datos Postgres (Neon, Vercel Postgres, Supabase…).
# Sin esto el sitio anda igual, con el catálogo de ejemplo, pero el panel
# no puede guardar nada.
DATABASE_URL=

# WhatsApp de la marca, con código de país y sin signos: 5219841234567
# Sin esto, el sitio no muestra ningún botón de WhatsApp y coordina por correo.
NEXT_PUBLIC_WHATSAPP=

# Correo de contacto. Sin esto usa hola@shaulatulum.mx, que es de ejemplo.
NEXT_PUBLIC_CORREO=
